{
  "manifest_version": 3,
  "name": "智学云 Browser Bridge",
  "version": "0.1.0",
  "description": "本地桥接扩展：让本机脚本通过 127.0.0.1 操控 Edge（导航 / 点击 / 输入 / 截图 / 读页面）。",
  "minimum_chrome_version": "109",
  "permissions": ["tabs", "scripting", "activeTab", "storage", "alarms"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Bridge"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*"
  }
}
