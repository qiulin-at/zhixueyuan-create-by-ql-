# 复制本文件为 backend/.env 后按需修改
# 数据库：默认 SQLite（开箱即跑）；切换 MySQL 示例：
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhixueyun?charset=utf8mb4
DATABASE_URL=

JWT_SECRET=change-me-in-production-8f3a9c-2f7d4b6e9a1c5d8f
JWT_EXPIRE_MINUTES=10080

# 留空则所有 AI 功能走 Mock 本地引擎（演示不依赖网络）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO=true