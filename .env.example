# Docker Compose 环境变量示例：复制为根目录 .env 后按需修改
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=zhixueyun
MYSQL_USER=zhixueyun
MYSQL_PASSWORD=zhixueyun

JWT_SECRET=change-me-in-production-8f3a9c-2f7d4b6e9a1c5d8f
JWT_EXPIRE_MINUTES=10080

# 留空则所有 AI 功能走 Mock 本地引擎（演示不依赖网络）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 首次启动且 users 表为空时自动导入演示数据；已有数据不会覆盖
SEED_ON_START=true
HTTP_PORT=8080